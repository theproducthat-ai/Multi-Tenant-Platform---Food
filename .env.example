# Copy this file to .env.local (frontend apps) or .env (apps/api, scripts, Supabase CLI)
# and fill in real values. Never commit a file containing real secrets.

# --- Supabase: public, browser-safe configuration ---
# The publishable key is Supabase's current key format, replacing the legacy "anon" key.
# It is safe to ship in a browser bundle — it only ever grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server-side only (apps/api, scripts/) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The secret key replaces the legacy "service_role" key. It bypasses RLS entirely.
# Server-side only — never prefix NEXT_PUBLIC_, never reference from client code.
SUPABASE_SECRET_KEY=

# --- Legacy Supabase key names ---
# Older projects (or ones not yet migrated) may still need the JWT-style keys instead
# of the publishable/secret keys above. Prefer the publishable/secret keys when available.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Platform ---
API_BASE_URL=
NODE_ENV=

# Explicit environment markers (independent of NODE_ENV) so scripts that touch the
# database can verify which tier they're pointed at before doing anything privileged.
# One of: development | staging | production
APP_ENV=
SUPABASE_ENV=
